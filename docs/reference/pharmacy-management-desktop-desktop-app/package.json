{
  "name": "pharmacy-management-desktop",
  "version": "1.0.0",
  "description": "Desktop application for the Pharmacy Management System",
  "main": "index.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder --win"
  },
  "author": "Abdul Rizaq",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.pharmacy.management",
    "productName": "Pharmacy Management System",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "index.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist",
        "to": "backend/dist"
      },
      {
        "from": "../backend/production-dependencies/node_modules",
        "to": "backend/node_modules"
      },
      {
        "from": "../backend/prisma",
        "to": "backend/prisma"
      },
      {
        "from": "../frontend/.next/standalone",
        "to": "frontend/standalone"
      },
      {
        "from": "../frontend/.next/standalone/node_modules",
        "to": "frontend/standalone/node_modules"
      },
      {
        "from": "../frontend/.next/static",
        "to": "frontend/standalone/.next/static"
      },
      {
        "from": "../frontend/public",
        "to": "frontend/standalone/public"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pharmacy Management System"
    }
  }
}
