"use client";

import { useEffect, useMemo, useState } from "react";
import Link from "next/link";
import { apiFetch } from "@/lib/api";
import AppLayout from "@/components/AppLayout";
import { useI18n } from "@/lib/i18n/I18nProvider";

type Supplier = {
  id: string;
  name: string;
};

type Medicine = {
  id: string;
  name: string;
  genericName?: string | null;
};

type PurchaseItem = {
  id: string;
  medicineId: string;
  orderedQuantity: string;
  unitCost: string;
  totalCost: string;
  medicine?: Medicine;
};

type Purchase = {
  id: string;
  purchaseNumber: string;
  status: string;
  expectedDate?: string | null;
  totalAmount: string;
  createdAt: string;
  supplier?: Supplier;
  items: PurchaseItem[];
};

type PurchasesResponse = {
  purchases: Purchase[];
};

type SuppliersResponse = {
  suppliers: Supplier[];
};

type MedicinesResponse = {
  medicines: Medicine[];
};

type PurchaseFormItem = {
  medicineId: string;
  orderedQuantity: string;
  unitCost: string;
};

type ReceiveFormItem = {
  purchaseItemId: string;
  medicineName: string;
  orderedQuantity: string;
  quantityReceived: string;
  batchNumber: string;
  expiryDate: string;
};

const emptyPurchaseItem: PurchaseFormItem = {
  medicineId: "",
  orderedQuantity: "1",
  unitCost: "",
};

export default function PurchasesPage() {
  const { t, language } = useI18n();

  const [purchases, setPurchases] = useState<Purchase[]>([]);
  const [suppliers, setSuppliers] = useState<Supplier[]>([]);
  const [medicines, setMedicines] = useState<Medicine[]>([]);

  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  const [showCreateModal, setShowCreateModal] = useState(false);
  const [creating, setCreating] = useState(false);

  const [purchaseNumber, setPurchaseNumber] = useState("");
  const [supplierId, setSupplierId] = useState("");
  const [expectedDate, setExpectedDate] = useState("");
  const [notes, setNotes] = useState("");

  const [items, setItems] = useState<PurchaseFormItem[]>([
    { ...emptyPurchaseItem },
  ]);

  const [showReceiveModal, setShowReceiveModal] = useState(false);
  const [receiving, setReceiving] = useState(false);
  const [selectedPurchase, setSelectedPurchase] =
    useState<Purchase | null>(null);

  const [receiptNumber, setReceiptNumber] = useState("");
  const [receiveNotes, setReceiveNotes] = useState("");
  const [receiveItems, setReceiveItems] = useState<ReceiveFormItem[]>([]);

  async function loadPurchases() {
    const response = await apiFetch<PurchasesResponse>("/purchases");

    setPurchases(response.purchases);
  }

  async function loadFormData() {
    const [suppliersResponse, medicinesResponse] = await Promise.all([
      apiFetch<SuppliersResponse>("/suppliers"),
      apiFetch<MedicinesResponse>("/medicines"),
    ]);

    setSuppliers(suppliersResponse.suppliers);
    setMedicines(medicinesResponse.medicines);
  }

  useEffect(() => {
    async function loadData() {
      try {
        setLoading(true);
        setError("");

        await Promise.all([
          loadPurchases(),
          loadFormData(),
        ]);
      } catch (err) {
        setError(
          err instanceof Error
            ? err.message
            : t("purchases.errors.load"),
        );
      } finally {
        setLoading(false);
      }
    }

    loadData();
  }, []);

  function formatDate(date: string) {
    return new Intl.DateTimeFormat(
      language === "ar" ? "ar-SA" : "en-GB",
      {
        dateStyle: "medium",
        timeStyle: "short",
      },
    ).format(new Date(date));
  }

  function formatMoney(value: string | number) {
    return new Intl.NumberFormat(
      language === "ar" ? "ar-SA" : "id-ID",
      {
        style: "currency",
        currency: "IDR",
        maximumFractionDigits: 0,
      },
    ).format(Number(value));
  }

  function formatStatus(status: string) {
    switch (status) {
      case "RECEIVED":
        return t("purchases.status.received");

      case "PARTIALLY_RECEIVED":
        return t("purchases.status.partiallyReceived");

      case "CANCELLED":
        return t("purchases.status.cancelled");

      case "DRAFT":
        return t("purchases.status.draft");

      default:
        return status
          .replace(/_/g, " ")
          .toLowerCase()
          .replace(/\b\w/g, (letter) => letter.toUpperCase());
    }
  }

  function getStatusClass(status: string) {
    switch (status) {
      case "RECEIVED":
        return "bg-emerald-50 text-emerald-700";

      case "PARTIALLY_RECEIVED":
        return "bg-amber-50 text-amber-700";

      case "CANCELLED":
        return "bg-red-50 text-red-700";

      case "DRAFT":
        return "bg-slate-100 text-slate-700";

      default:
        return "bg-slate-100 text-slate-700";
    }
  }

  function updateItem(
    index: number,
    field: keyof PurchaseFormItem,
    value: string,
  ) {
    setItems((currentItems) =>
      currentItems.map((item, itemIndex) =>
        itemIndex === index
          ? {
              ...item,
              [field]: value,
            }
          : item,
      ),
    );
  }

  function addItem() {
    setItems((currentItems) => [
      ...currentItems,
      { ...emptyPurchaseItem },
    ]);
  }

  function removeItem(index: number) {
    setItems((currentItems) =>
      currentItems.filter((_, itemIndex) => itemIndex !== index),
    );
  }

  function resetCreateForm() {
    setPurchaseNumber("");
    setSupplierId("");
    setExpectedDate("");
    setNotes("");
    setItems([{ ...emptyPurchaseItem }]);
  }

  function closeCreateModal() {
    if (creating) {
      return;
    }

    setShowCreateModal(false);
    resetCreateForm();
  }

  const formTotal = useMemo(() => {
    return items.reduce((total, item) => {
      const quantity = Number(item.orderedQuantity);
      const unitCost = Number(item.unitCost);

      if (
        !Number.isFinite(quantity) ||
        !Number.isFinite(unitCost)
      ) {
        return total;
      }

      return total + quantity * unitCost;
    }, 0);
  }, [items]);

  async function handleCreatePurchase(
    event: React.FormEvent<HTMLFormElement>,
  ) {
    event.preventDefault();

    setError("");

    if (!supplierId) {
      setError(t("purchases.validation.supplier"));
      return;
    }

    if (!purchaseNumber.trim()) {
      setError(t("purchases.validation.purchaseNumber"));
      return;
    }

    if (items.length === 0) {
      setError(t("purchases.validation.items"));
      return;
    }

    for (const item of items) {
      if (!item.medicineId) {
        setError(t("purchases.validation.medicine"));
        return;
      }

      const quantity = Number(item.orderedQuantity);
      const unitCost = Number(item.unitCost);

      if (!Number.isFinite(quantity) || quantity <= 0) {
        setError(t("purchases.validation.quantity"));
        return;
      }

      if (!Number.isFinite(unitCost) || unitCost < 0) {
        setError(t("purchases.validation.unitCost"));
        return;
      }
    }

    try {
      setCreating(true);

      await apiFetch("/purchases", {
        method: "POST",
        body: JSON.stringify({
          supplierId,
          purchaseNumber: purchaseNumber.trim(),

          ...(expectedDate && {
            expectedDate,
          }),

          ...(notes.trim() && {
            notes: notes.trim(),
          }),

          items: items.map((item) => ({
            medicineId: item.medicineId,
            orderedQuantity: Number(item.orderedQuantity),
            unitCost: Number(item.unitCost),
          })),
        }),
      });

      await loadPurchases();

      setShowCreateModal(false);
      resetCreateForm();
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : t("purchases.errors.create"),
      );
    } finally {
      setCreating(false);
    }
  }

  function openReceiveModal(purchase: Purchase) {
    setError("");
    setSelectedPurchase(purchase);

    setReceiptNumber(`GR-${purchase.purchaseNumber}`);

    setReceiveNotes("");

    setReceiveItems(
      purchase.items.map((item) => ({
        purchaseItemId: item.id,
        medicineName:
          item.medicine?.name ?? t("purchases.unknownMedicine"),
        orderedQuantity: item.orderedQuantity,
        quantityReceived: item.orderedQuantity,
        batchNumber: "",
        expiryDate: "",
      })),
    );

    setShowReceiveModal(true);
  }

  function closeReceiveModal() {
    if (receiving) {
      return;
    }

    setShowReceiveModal(false);
    setSelectedPurchase(null);
    setReceiptNumber("");
    setReceiveNotes("");
    setReceiveItems([]);
  }

  function updateReceiveItem(
    index: number,
    field: keyof ReceiveFormItem,
    value: string,
  ) {
    setReceiveItems((currentItems) =>
      currentItems.map((item, itemIndex) =>
        itemIndex === index
          ? {
              ...item,
              [field]: value,
            }
          : item,
      ),
    );
  }

  async function handleReceivePurchase(
    event: React.FormEvent<HTMLFormElement>,
  ) {
    event.preventDefault();

    setError("");

    if (!selectedPurchase) {
      setError(t("purchases.validation.noPurchase"));
      return;
    }

    if (!receiptNumber.trim()) {
      setError(t("purchases.validation.receiptNumber"));
      return;
    }

    if (receiveItems.length === 0) {
      setError(t("purchases.validation.receiptItems"));
      return;
    }

    for (const item of receiveItems) {
      const quantity = Number(item.quantityReceived);

      if (!item.purchaseItemId) {
        setError(t("purchases.validation.invalidItem"));
        return;
      }

      if (!item.batchNumber.trim()) {
        setError(
          t("purchases.validation.batchRequired").replace(
            "{medicine}",
            item.medicineName,
          ),
        );
        return;
      }

      if (!item.expiryDate) {
        setError(
          t("purchases.validation.expiryRequired").replace(
            "{medicine}",
            item.medicineName,
          ),
        );
        return;
      }

      if (!Number.isFinite(quantity) || quantity <= 0) {
        setError(
          t("purchases.validation.receivedQuantity").replace(
            "{medicine}",
            item.medicineName,
          ),
        );
        return;
      }

      if (quantity > Number(item.orderedQuantity)) {
        setError(
          t("purchases.validation.quantityExceeded").replace(
            "{medicine}",
            item.medicineName,
          ),
        );
        return;
      }
    }

    try {
      setReceiving(true);

      await apiFetch(
        `/purchases/${selectedPurchase.id}/receive`,
        {
          method: "POST",
          body: JSON.stringify({
            receiptNumber: receiptNumber.trim(),

            items: receiveItems.map((item) => ({
              purchaseItemId: item.purchaseItemId,
              batchNumber: item.batchNumber.trim(),
              expiryDate: item.expiryDate,
              quantityReceived: Number(item.quantityReceived),
            })),

            ...(receiveNotes.trim() && {
              notes: receiveNotes.trim(),
            }),
          }),
        },
      );

      await loadPurchases();

      closeReceiveModal();
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : t("purchases.errors.receive"),
      );
    } finally {
      setReceiving(false);
    }
  }

  return (
    <AppLayout>
      <div>
        <div className="mb-7 flex items-start justify-between gap-4">
          <div>
            <h2 className="text-2xl font-bold tracking-tight">
              {t("purchases.title")}
            </h2>

            <p className="mt-1 text-sm text-slate-500">
              {t("purchases.description")}
            </p>
          </div>

          <button
            type="button"
            onClick={() => {
              setError("");
              setShowCreateModal(true);
            }}
            className="rounded-lg bg-slate-950 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-slate-800"
          >
            {t("purchases.actions.createPurchase")}
          </button>
        </div>

        {error && (
          <div className="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
            {error}
          </div>
        )}

        <section className="rounded-xl border border-slate-200 bg-white">
          <div className="border-b border-slate-200 px-5 py-4">
            <h3 className="text-sm font-bold text-slate-900">
              {t("purchases.list.title")}
            </h3>

            <p className="mt-1 text-xs text-slate-500">
              {t("purchases.list.description")}
            </p>
          </div>

          {loading ? (
            <div className="flex items-center justify-center px-6 py-16">
              <div className="text-center">
                <div className="mx-auto h-8 w-8 animate-spin rounded-full border-2 border-slate-300 border-t-slate-900" />

                <p className="mt-4 text-sm text-slate-500">
                  {t("purchases.loading")}
                </p>
              </div>
            </div>
          ) : purchases.length === 0 ? (
            <div className="px-6 py-16 text-center">
              <p className="text-sm text-slate-500">
                {t("purchases.empty.title")}
              </p>

              <p className="mt-1 text-xs text-slate-400">
                {t("purchases.empty.description")}
              </p>
            </div>
          ) : (
            <div className="overflow-x-auto">
              <table className="w-full min-w-[1150px] text-left">
                <thead className="border-b border-slate-200 bg-slate-50">
                  <tr>
                    <th className="px-5 py-3 text-xs font-semibold uppercase tracking-wide text-slate-500">
                      {t("purchases.fields.date")}
                    </th>

                    <th className="px-5 py-3 text-xs font-semibold uppercase tracking-wide text-slate-500">
                      {t("purchases.fields.purchaseNumber")}
                    </th>

                    <th className="px-5 py-3 text-xs font-semibold uppercase tracking-wide text-slate-500">
                      {t("purchases.fields.supplier")}
                    </th>

                    <th className="px-5 py-3 text-xs font-semibold uppercase tracking-wide text-slate-500">
                      {t("purchases.fields.items")}
                    </th>

                    <th className="px-5 py-3 text-xs font-semibold uppercase tracking-wide text-slate-500">
                      {t("purchases.fields.total")}
                    </th>

                    <th className="px-5 py-3 text-xs font-semibold uppercase tracking-wide text-slate-500">
                      {t("purchases.fields.status")}
                    </th>

                    <th className="px-5 py-3 text-xs font-semibold uppercase tracking-wide text-slate-500">
                      {t("purchases.fields.actions")}
                    </th>
                  </tr>
                </thead>

                <tbody className="divide-y divide-slate-100">
                  {purchases.map((purchase) => (
                    <tr
                      key={purchase.id}
                      className="transition hover:bg-slate-50"
                    >
                      <td className="whitespace-nowrap px-5 py-4 text-sm text-slate-600">
                        {formatDate(purchase.createdAt)}
                      </td>

                      <td className="px-5 py-4">
                        <Link
                          href={`/purchases/${purchase.id}`}
                          className="text-sm font-semibold text-slate-800 hover:text-slate-500 hover:underline"
                        >
                          {purchase.purchaseNumber}
                        </Link>
                      </td>

                      <td className="px-5 py-4">
                        <p className="text-sm text-slate-700">
                          {purchase.supplier?.name ??
                            t("purchases.unknownSupplier")}
                        </p>
                      </td>

                      <td className="px-5 py-4 text-sm text-slate-600">
                        {purchase.items.length}
                      </td>

                      <td className="whitespace-nowrap px-5 py-4 text-sm font-semibold text-slate-800">
                        {formatMoney(purchase.totalAmount)}
                      </td>

                      <td className="px-5 py-4">
                        <span
                          className={`inline-flex rounded-full px-2.5 py-1 text-xs font-semibold ${getStatusClass(
                            purchase.status,
                          )}`}
                        >
                          {formatStatus(purchase.status)}
                        </span>
                      </td>

                      <td className="px-5 py-4">
                        {purchase.status === "DRAFT" ||
                        purchase.status === "PARTIALLY_RECEIVED" ? (
                          <button
                            type="button"
                            onClick={() =>
                              openReceiveModal(purchase)
                            }
                            className="rounded-lg bg-slate-950 px-3 py-2 text-xs font-semibold text-white transition hover:bg-slate-800"
                          >
                            {t("purchases.actions.receive")}
                          </button>
                        ) : (
                          <span className="text-xs text-slate-400">
                            {t("purchases.actions.noAction")}
                          </span>
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </section>

        {showCreateModal && (
          <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/40 px-4 py-8">
            <div className="flex max-h-[90vh] w-full max-w-4xl flex-col overflow-hidden rounded-2xl bg-white shadow-2xl">
              <div className="flex items-start justify-between border-b border-slate-200 px-6 py-5">
                <div>
                  <h3 className="text-lg font-bold text-slate-900">
                    {t("purchases.create.title")}
                  </h3>

                  <p className="mt-1 text-sm text-slate-500">
                    {t("purchases.create.description")}
                  </p>
                </div>

                <button
                  type="button"
                  onClick={closeCreateModal}
                  disabled={creating}
                  className="text-sm font-medium text-slate-500 transition hover:text-slate-900 disabled:opacity-50"
                >
                  {t("common.close")}
                </button>
              </div>

              <form
                onSubmit={handleCreatePurchase}
                className="overflow-y-auto"
              >
                <div className="space-y-6 px-6 py-6">
                  <section>
                    <h4 className="text-sm font-bold text-slate-900">
                      {t("purchases.create.purchaseInformation")}
                    </h4>

                    <div className="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2">
                      <div>
                        <label className="mb-1.5 block text-sm font-medium text-slate-700">
                          {t("purchases.fields.purchaseNumberRequired")}
                        </label>

                        <input
                          type="text"
                          value={purchaseNumber}
                          onChange={(event) =>
                            setPurchaseNumber(event.target.value)
                          }
                          placeholder={t(
                            "purchases.placeholders.purchaseNumber",
                          )}
                          autoComplete="off"
                          disabled={creating}
                          className="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-100"
                        />
                      </div>

                      <div>
                        <label className="mb-1.5 block text-sm font-medium text-slate-700">
                          {t("purchases.fields.supplierRequired")}
                        </label>

                        <select
                          value={supplierId}
                          onChange={(event) =>
                            setSupplierId(event.target.value)
                          }
                          disabled={creating}
                          className="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-100"
                        >
                          <option value="">
                            {t("purchases.placeholders.selectSupplier")}
                          </option>

                          {suppliers.map((supplier) => (
                            <option
                              key={supplier.id}
                              value={supplier.id}
                            >
                              {supplier.name}
                            </option>
                          ))}
                        </select>
                      </div>

                      <div>
                        <label className="mb-1.5 block text-sm font-medium text-slate-700">
                          {t("purchases.fields.expectedDate")}
                        </label>

                        <input
                          type="date"
                          value={expectedDate}
                          onChange={(event) =>
                            setExpectedDate(event.target.value)
                          }
                          disabled={creating}
                          className="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-100"
                        />
                      </div>

                      <div>
                        <label className="mb-1.5 block text-sm font-medium text-slate-700">
                          {t("purchases.fields.notes")}
                        </label>

                        <input
                          type="text"
                          value={notes}
                          onChange={(event) =>
                            setNotes(event.target.value)
                          }
                          placeholder={t(
                            "purchases.placeholders.optionalNotes",
                          )}
                          disabled={creating}
                          className="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-100"
                        />
                      </div>
                    </div>
                  </section>

                  <section>
                    <div className="flex items-center justify-between gap-4">
                      <div>
                        <h4 className="text-sm font-bold text-slate-900">
                          {t("purchases.create.purchaseItems")}
                        </h4>

                        <p className="mt-1 text-xs text-slate-500">
                          {t("purchases.create.purchaseItemsDescription")}
                        </p>
                      </div>

                      <button
                        type="button"
                        onClick={addItem}
                        disabled={creating}
                        className="rounded-lg border border-slate-300 px-3 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 disabled:opacity-50"
                      >
                        + {t("purchases.actions.addItem")}
                      </button>
                    </div>

                    <div className="mt-4 space-y-3">
                      {items.map((item, index) => {
                        const lineTotal =
                          Number(item.orderedQuantity || 0) *
                          Number(item.unitCost || 0);

                        return (
                          <div
                            key={index}
                            className="rounded-xl border border-slate-200 bg-slate-50 p-4"
                          >
                            <div className="grid grid-cols-1 gap-4 md:grid-cols-[2fr_1fr_1fr_auto]">
                              <div>
                                <label className="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-500">
                                  {t("purchases.fields.medicine")}
                                </label>

                                <select
                                  value={item.medicineId}
                                  onChange={(event) =>
                                    updateItem(
                                      index,
                                      "medicineId",
                                      event.target.value,
                                    )
                                  }
                                  disabled={creating}
                                  className="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-100"
                                >
                                  <option value="">
                                    {t(
                                      "purchases.placeholders.selectMedicine",
                                    )}
                                  </option>

                                  {medicines.map((medicine) => (
                                    <option
                                      key={medicine.id}
                                      value={medicine.id}
                                    >
                                      {medicine.name}
                                    </option>
                                  ))}
                                </select>
                              </div>

                              <div>
                                <label className="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-500">
                                  {t("purchases.fields.quantity")}
                                </label>

                                <input
                                  type="number"
                                  min="1"
                                  step="1"
                                  value={item.orderedQuantity}
                                  onChange={(event) =>
                                    updateItem(
                                      index,
                                      "orderedQuantity",
                                      event.target.value,
                                    )
                                  }
                                  disabled={creating}
                                  className="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-100"
                                />
                              </div>

                              <div>
                                <label className="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-500">
                                  {t("purchases.fields.unitCost")}
                                </label>

                                <input
                                  type="number"
                                  min="0"
                                  step="1"
                                  value={item.unitCost}
                                  onChange={(event) =>
                                    updateItem(
                                      index,
                                      "unitCost",
                                      event.target.value,
                                    )
                                  }
                                  placeholder="0"
                                  disabled={creating}
                                  className="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-100"
                                />
                              </div>

                              <div className="flex items-end">
                                <button
                                  type="button"
                                  onClick={() =>
                                    removeItem(index)
                                  }
                                  disabled={
                                    creating || items.length === 1
                                  }
                                  className="w-full rounded-lg border border-red-200 px-3 py-2.5 text-sm font-semibold text-red-600 transition hover:bg-red-50 disabled:cursor-not-allowed disabled:opacity-40 md:w-auto"
                                >
                                  {t("purchases.actions.remove")}
                                </button>
                              </div>
                            </div>

                            <div className="mt-3 flex justify-end border-t border-slate-200 pt-3">
                              <p className="text-sm text-slate-600">
                                {t("purchases.fields.lineTotal")}:{" "}
                                <span className="font-bold text-slate-900">
                                  {formatMoney(lineTotal)}
                                </span>
                              </p>
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  </section>

                  <div className="flex items-center justify-between rounded-xl bg-slate-50 px-5 py-4">
                    <span className="text-sm font-medium text-slate-600">
                      {t("purchases.fields.purchaseTotal")}
                    </span>

                    <span className="text-lg font-bold text-slate-900">
                      {formatMoney(formTotal)}
                    </span>
                  </div>
                </div>

                <div className="flex items-center justify-end gap-3 border-t border-slate-200 px-6 py-4">
                  <button
                    type="button"
                    onClick={closeCreateModal}
                    disabled={creating}
                    className="rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 disabled:opacity-50"
                  >
                    {t("common.cancel")}
                  </button>

                  <button
                    type="submit"
                    disabled={creating}
                    className="rounded-lg bg-slate-950 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-slate-800 disabled:cursor-not-allowed disabled:opacity-50"
                  >
                    {creating
                      ? t("purchases.actions.creating")
                      : t("purchases.actions.createPurchase")}
                  </button>
                </div>
              </form>
            </div>
          </div>
        )}

        {showReceiveModal && selectedPurchase && (
          <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/40 px-4 py-8">
            <div className="flex max-h-[90vh] w-full max-w-4xl flex-col overflow-hidden rounded-2xl bg-white shadow-2xl">
              <div className="flex items-start justify-between border-b border-slate-200 px-6 py-5">
                <div>
                  <h3 className="text-lg font-bold text-slate-900">
                    {t("purchases.receive.title")}
                  </h3>

                  <p className="mt-1 text-sm text-slate-500">
                    {t("purchases.receive.description")}{" "}
                    <span className="font-semibold">
                      {selectedPurchase.purchaseNumber}
                    </span>
                  </p>
                </div>

                <button
                  type="button"
                  onClick={closeReceiveModal}
                  disabled={receiving}
                  className="text-sm font-medium text-slate-500 transition hover:text-slate-900 disabled:opacity-50"
                >
                  {t("common.close")}
                </button>
              </div>

              <form
                onSubmit={handleReceivePurchase}
                className="overflow-y-auto"
              >
                <div className="space-y-6 px-6 py-6">
                  <section>
                    <h4 className="text-sm font-bold text-slate-900">
                      {t("purchases.receive.receiptInformation")}
                    </h4>

                    <div className="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2">
                      <div>
                        <label className="mb-1.5 block text-sm font-medium text-slate-700">
                          {t("purchases.fields.receiptNumberRequired")}
                        </label>

                        <input
                          type="text"
                          value={receiptNumber}
                          onChange={(event) =>
                            setReceiptNumber(event.target.value)
                          }
                          disabled={receiving}
                          placeholder={t(
                            "purchases.placeholders.receiptNumber",
                          )}
                          className="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-100"
                        />
                      </div>

                      <div>
                        <label className="mb-1.5 block text-sm font-medium text-slate-700">
                          {t("purchases.fields.notes")}
                        </label>

                        <input
                          type="text"
                          value={receiveNotes}
                          onChange={(event) =>
                            setReceiveNotes(event.target.value)
                          }
                          disabled={receiving}
                          placeholder={t(
                            "purchases.placeholders.optionalNotes",
                          )}
                          className="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-100"
                        />
                      </div>
                    </div>
                  </section>

                  <section>
                    <h4 className="text-sm font-bold text-slate-900">
                      {t("purchases.receive.itemsReceived")}
                    </h4>

                    <p className="mt-1 text-xs text-slate-500">
                      {t(
                        "purchases.receive.itemsReceivedDescription",
                      )}
                    </p>

                    <div className="mt-4 space-y-4">
                      {receiveItems.map((item, index) => (
                        <div
                          key={item.purchaseItemId}
                          className="rounded-xl border border-slate-200 bg-slate-50 p-4"
                        >
                          <div className="mb-4 flex items-center justify-between">
                            <div>
                              <p className="text-sm font-bold text-slate-900">
                                {item.medicineName}
                              </p>

                              <p className="mt-1 text-xs text-slate-500">
                                {t(
                                  "purchases.receive.orderedQuantity",
                                )}
                                : {item.orderedQuantity}
                              </p>
                            </div>
                          </div>

                          <div className="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
                            <div>
                              <label className="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-500">
                                {t(
                                  "purchases.fields.quantityReceivedRequired",
                                )}
                              </label>

                              <input
                                type="number"
                                min="1"
                                step="1"
                                value={item.quantityReceived}
                                onChange={(event) =>
                                  updateReceiveItem(
                                    index,
                                    "quantityReceived",
                                    event.target.value,
                                  )
                                }
                                disabled={receiving}
                                className="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-100"
                              />
                            </div>

                            <div>
                              <label className="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-500">
                                {t(
                                  "purchases.fields.batchNumberRequired",
                                )}
                              </label>

                              <input
                                type="text"
                                value={item.batchNumber}
                                onChange={(event) =>
                                  updateReceiveItem(
                                    index,
                                    "batchNumber",
                                    event.target.value,
                                  )
                                }
                                disabled={receiving}
                                placeholder={t(
                                  "purchases.placeholders.batchNumber",
                                )}
                                className="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-100"
                              />
                            </div>

                            <div>
                              <label className="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-500">
                                {t(
                                  "purchases.fields.expiryDateRequired",
                                )}
                              </label>

                              <input
                                type="date"
                                value={item.expiryDate}
                                onChange={(event) =>
                                  updateReceiveItem(
                                    index,
                                    "expiryDate",
                                    event.target.value,
                                  )
                                }
                                disabled={receiving}
                                className="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-100"
                              />
                            </div>

                            <div>
                              <label className="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-500">
                                {t("purchases.fields.unitCost")}
                              </label>

                              <div className="rounded-lg border border-slate-200 bg-slate-100 px-3 py-2.5 text-sm text-slate-600">
                                {formatMoney(
                                  item.purchaseItemId
                                    ? selectedPurchase.items.find(
                                        (purchaseItem) =>
                                          purchaseItem.id ===
                                          item.purchaseItemId,
                                      )?.unitCost ?? 0
                                    : 0,
                                )}
                              </div>
                            </div>
                          </div>
                        </div>
                      ))}
                    </div>
                  </section>
                </div>

                <div className="flex items-center justify-end gap-3 border-t border-slate-200 px-6 py-4">
                  <button
                    type="button"
                    onClick={closeReceiveModal}
                    disabled={receiving}
                    className="rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 disabled:opacity-50"
                  >
                    {t("common.cancel")}
                  </button>

                  <button
                    type="submit"
                    disabled={receiving}
                    className="rounded-lg bg-slate-950 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-slate-800 disabled:cursor-not-allowed disabled:opacity-50"
                  >
                    {receiving
                      ? t("purchases.actions.receiving")
                      : t("purchases.actions.receivePurchase")}
                  </button>
                </div>
              </form>
            </div>
          </div>
        )}
      </div>
    </AppLayout>
  );
}